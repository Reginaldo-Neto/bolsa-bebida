{
  "name": "@bolsa/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "prisma": "dotenv -e ../../.env -- prisma",
    "db:generate": "prisma generate",
    "db:migrate": "pnpm prisma migrate dev",
    "db:deploy": "pnpm prisma migrate deploy",
    "db:push": "pnpm prisma db push",
    "db:studio": "pnpm prisma studio",
    "db:seed": "dotenv -e ../../.env -- tsx src/seed.ts"
  },
  "dependencies": {
    "@bolsa/shared": "workspace:*",
    "@prisma/client": "^6.2.1",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2"
  }
}
