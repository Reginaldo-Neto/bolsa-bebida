// Data model of spec 9.
//
// Rules that hold across every table:
// - ids are UUID v7, generated in application code for index locality
// - money is an integer number of euro cents, never a float
// - timestamps are timestamptz

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED_SALES
  FINISHED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  PARTIALLY_REDEEMED
  REDEEMED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum QuoteStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  CANCELLED
}

enum VoucherStatus {
  ACTIVE
  PARTIALLY_REDEEMED
  REDEEMED
  REFUNDED
  CANCELLED
}

enum StaffRole {
  STAFF
  /// Sells at the till, for customers who pay in cash or on the bar's own
  /// card terminal instead of through the application.
  CASHIER
  ADMIN
}

/// How the money actually reached the bar. MBWAY is the only one the
/// application settles itself; the other two happen off the application.
enum PaymentMethod {
  MBWAY
  CASH
  CARD_TERMINAL
}

enum InvoiceStatus {
  PENDING
  ISSUED
  FAILED
}

enum ActorType {
  PARTICIPANT
  STAFF
  ADMIN
  SYSTEM
}

model Event {
  id       String      @id
  name     String
  status   EventStatus @default(DRAFT)
  timezone String      @default("Europe/Lisbon")

  /// Spec 4.1: emergency switch. Prices return to base and the engine stops.
  fixedPrices Boolean @default(false) @map("fixed_prices")
  /// Sequence number of the last tick the worker completed.
  currentTick Int       @default(0) @map("current_tick")
  /// When that tick ran. The next tick counts sales confirmed after it.
  lastTickAt  DateTime? @map("last_tick_at") @db.Timestamptz(3)

  /// Validated by engineParamsSchema; versioned so old ticks stay explainable.
  engineParams Json @map("engine_params")
  /// Purchase limits of spec 4.4 and L8.
  limits       Json

  startsAt DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime? @map("ends_at") @db.Timestamptz(3)

  /// L7: personal data is anonymised this many days after the event.
  retentionDays Int     @default(30) @map("retention_days")
  privacyText   String? @map("privacy_text")
  termsText     String? @map("terms_text")
  refundText    String? @map("refund_text")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  groups       ProductGroup[]
  products     Product[]
  participants Participant[]
  priceTicks   PriceTick[]
  vouchers     Voucher[]
  staffUsers   StaffUser[]
  auditLog     AuditLog[]

  @@map("events")
}

model ProductGroup {
  id      String @id
  eventId String @map("event_id")
  name    String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([eventId, name])
  @@map("product_groups")
}

model Product {
  id      String  @id
  eventId String  @map("event_id")
  groupId String  @map("group_id")
  name    String
  /// Free-text category used by the market filters (spec 4.3).
  category String?

  isAlcoholic Boolean @default(true) @map("is_alcoholic")
  volumeMl    Int?    @map("volume_ml")

  /// L6: a fiscal document needs a VAT rate per line. In Portuguese catering
  /// alcoholic drinks are taxed at the standard rate and most non-alcoholic
  /// ones at the intermediate rate, so it cannot be a single global setting.
  /// Stored in basis points (2300 = 23%), keeping the "no floats" rule that
  /// money already follows.
  vatBasisPoints Int @default(2300) @map("vat_basis_points")

  costCents      Int @map("cost_cents")
  basePriceCents Int @map("base_price_cents")
  minPriceCents  Int @map("min_price_cents")
  maxPriceCents  Int @map("max_price_cents")

  stockInitial   Int @default(0) @map("stock_initial")
  stockAvailable Int @default(0) @map("stock_available")
  stockReserved  Int @default(0) @map("stock_reserved")
  stockSold      Int @default(0) @map("stock_sold")

  sortOrder Int     @default(0) @map("sort_order")
  imageUrl  String? @map("image_url")
  archived  Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group       ProductGroup       @relation(fields: [groupId], references: [id])
  engineState ProductEngineState?
  orderItems  OrderItem[]
  priceTicks  PriceTick[]

  @@unique([eventId, name])
  @@index([eventId, sortOrder])
  @@map("products")
}

model ProductEngineState {
  productId String @id @map("product_id")

  currentPriceCents Int @map("current_price_cents")
  /// Unrounded price carried between ticks so sub-step moves are not lost.
  rawPrice          Float @map("raw_price")
  smoothedDemand    Float @default(0) @map("smoothed_demand")
  expectedShare     Float? @map("expected_share")

  /// Spec 4.7: admin price override, always clamped into [min, max].
  overridePriceCents Int? @map("override_price_cents")
  overrideUntilTick  Int? @map("override_until_tick")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_engine_state")
}

model PriceTick {
  id        String @id
  eventId   String @map("event_id")
  tick      Int
  productId String @map("product_id")

  priceCents Int @map("price_cents")
  paidUnits  Int @default(0) @map("paid_units")
  /// Signals behind the move: { x, r, k, delta, c }.
  explain    Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([eventId, tick, productId])
  @@index([eventId, tick])
  @@index([productId, createdAt])
  @@map("price_ticks")
}

model Participant {
  id      String @id
  eventId String @map("event_id")

  nickname          String
  isAdultDeclared   Boolean @default(false) @map("is_adult_declared")
  leaderboardOptIn  Boolean @default(false) @map("leaderboard_opt_in")
  teamCode          String? @map("team_code")

  /// L7: the phone number itself is never stored, only a hash for recovery.
  phoneHash String? @map("phone_hash")
  sessionId String  @unique @map("session_id")

  /// Created by the till for a walk-up customer who never opened the app.
  /// One row per counter sale, so the per-person limits of L8 stay per person
  /// instead of accumulating against the till itself.
  isCounter Boolean @default(false) @map("is_counter")

  /// Set when the retention window closes and the row is anonymised.
  anonymizedAt DateTime? @map("anonymized_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  quotes  Quote[]
  orders  Order[]

  @@unique([eventId, nickname])
  @@index([eventId, phoneHash])
  @@map("participants")
}

model Quote {
  id            String      @id
  participantId String      @map("participant_id")
  /// Locked prices: [{ productId, qty, unitPriceCents, basePriceCents }].
  items         Json
  totalCents    Int         @map("total_cents")
  status        QuoteStatus @default(ACTIVE)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  order       Order?

  @@index([status, expiresAt])
  @@map("quotes")
}

model Order {
  id            String      @id
  participantId String      @map("participant_id")
  quoteId       String      @unique @map("quote_id")
  status        OrderStatus @default(PENDING)
  totalCents    Int         @map("total_cents")
  /// L6: optional at checkout, validated when present.
  nif           String?
  paymentRef    String?     @map("payment_ref")
  /// Spec 6.1 covers MB WAY; a bar also takes notes and cards on its own
  /// terminal, and the end of the night has to reconcile against both.
  paymentMethod PaymentMethod @default(MBWAY) @map("payment_method")
  /// The cashier who rang it up. Null for anything the participant paid.
  soldByStaffId String?     @map("sold_by_staff_id")
  /// What was handed over in notes, to explain the change given. Cash only.
  cashReceivedCents Int?    @map("cash_received_cents")
  /// Deadline for the pending payment; the worker expires it after this.
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  quote       Quote       @relation(fields: [quoteId], references: [id])
  soldBy      StaffUser?  @relation("CounterSales", fields: [soldByStaffId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  voucher     Voucher?
  refunds     Refund[]
  invoice     Invoice?

  @@index([status, expiresAt])
  @@index([participantId, createdAt])
  @@index([soldByStaffId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String @id
  orderId   String @map("order_id")
  productId String @map("product_id")

  qty            Int
  unitPriceCents Int @map("unit_price_cents")
  /// Kept for the leaderboard: the base price at the moment of purchase.
  basePriceCentsAtPurchase Int @map("base_price_cents_at_purchase")
  redeemedQty    Int @default(0) @map("redeemed_qty")

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  redemptions Redemption[]

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id      String        @id
  orderId String        @map("order_id")
  provider String
  /// Idempotency key for webhooks (spec 12.1).
  providerRef String     @unique @map("provider_ref")
  status   PaymentStatus @default(PENDING)
  amountCents Int        @map("amount_cents")
  rawPayload  Json?      @map("raw_payload")
  receivedAt  DateTime?  @map("received_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("payments")
}

model Voucher {
  id      String        @id
  eventId String        @map("event_id")
  orderId String        @unique @map("order_id")
  /// Readable fallback when the QR will not scan (spec 4.5).
  shortCode String      @map("short_code")
  /// Ed25519 signature over "voucherId|eventId" (spec 10.3).
  signature String
  status    VoucherStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  redemptions Redemption[]

  @@unique([eventId, shortCode])
  @@map("vouchers")
}

model Redemption {
  id          String @id
  voucherId   String @map("voucher_id")
  orderItemId String @map("order_item_id")
  qty         Int
  staffUserId String @map("staff_user_id")
  pickupPoint String? @map("pickup_point")
  /// L5: staff confirmed the 18+ check for an alcoholic item.
  ageChecked  Boolean @default(false) @map("age_checked")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  voucher   Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  staffUser StaffUser @relation(fields: [staffUserId], references: [id])

  @@index([voucherId])
  @@map("redemptions")
}

model Refund {
  id          String  @id
  orderId     String  @map("order_id")
  amountCents Int     @map("amount_cents")
  reason      String
  adminUserId String  @map("admin_user_id")
  providerRef String? @map("provider_ref")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminUser StaffUser @relation(fields: [adminUserId], references: [id])

  @@index([orderId])
  @@map("refunds")
}

model Invoice {
  id      String        @id
  orderId String        @unique @map("order_id")
  provider String
  documentNumber String? @map("document_number")
  status   InvoiceStatus @default(PENDING)
  attempts Int           @default(0)
  lastError String?      @map("last_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, attempts])
  @@map("invoices")
}

model StaffUser {
  id      String    @id
  eventId String    @map("event_id")
  email   String
  passwordHash String @map("password_hash")
  role    StaffRole @default(STAFF)
  /// TOTP is mandatory for ADMIN (spec 3).
  totpSecret String? @map("totp_secret")
  pickupPoint String? @map("pickup_point")
  active  Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  redemptions  Redemption[]
  refunds      Refund[]
  counterSales Order[]      @relation("CounterSales")

  @@unique([eventId, email])
  @@map("staff_users")
}

model AuditLog {
  id        String    @id
  eventId   String    @map("event_id")
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id")
  action    String
  entity    String
  entityId  String?   @map("entity_id")
  before    Json?
  after     Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@map("audit_log")
}

/// Spec 10.1: repeated taps on a weak network must not create duplicate orders.
model IdempotencyKey {
  key         String @id
  scope       String
  requestHash String @map("request_hash")
  response    Json?
  statusCode  Int?   @map("status_code")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("idempotency_keys")
}
