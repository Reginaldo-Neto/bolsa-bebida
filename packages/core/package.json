    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-socket.io": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/websockets": "^12.0.3",
    "@node-rs/argon2": "^2.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.2.0",
    "otpauth": "^9.5.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
