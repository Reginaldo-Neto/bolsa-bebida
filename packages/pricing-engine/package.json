{
  "name": "@bolsa/pricing-engine",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-vectors/*": "./test-vectors/*"
  },
  "files": [
    "dist",
    "test-vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "vectors:generate": "tsx scripts/generate-vectors.ts"
  },
  "dependencies": {
    "@bolsa/shared": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2"
  }
}
