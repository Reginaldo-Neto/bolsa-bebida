# Copy to .env and adjust. Never commit the real .env.

# --- Database ---
POSTGRES_USER=bolsa
POSTGRES_PASSWORD=bolsa
POSTGRES_DB=bolsa
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bolsa:bolsa@localhost:5432/bolsa?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
NODE_ENV=development
# Set to true to print every SQL query. Very noisy; for debugging only.
LOG_QUERIES=false
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Sessions and auth ---
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-in-production-please-use-a-long-random-value
# Ed25519 key pair used to sign voucher QR codes (spec 10.3).
# Generate with: pnpm --filter @bolsa/api keys:generate
VOUCHER_SIGNING_PRIVATE_KEY=
VOUCHER_SIGNING_PUBLIC_KEY=

# --- Payments ---
# mock | mbway
PAYMENT_PROVIDER=mock
MBWAY_API_BASE_URL=
MBWAY_API_KEY=
MBWAY_WEBHOOK_SECRET=

# --- Invoicing (L6, AT certified software) ---
# mock | certified
INVOICING_PROVIDER=mock
INVOICING_API_BASE_URL=
INVOICING_API_KEY=

# --- Web (Vite) ---
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000

# --- Deployment ---
DOMAIN=localhost
