{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // CommonJS with node10 resolution: NestJS 12 publishes ESM, and node16
    // resolution refuses to require() it. Going full ESM would mean explicit
    // .js suffixes on every relative import plus CJS interop risk with Prisma,
    // BullMQ and socket.io. TypeScript is pinned to 5.9 in the root overrides,
    // where node10 resolution is still supported.
    "module": "commonjs",
    "moduleResolution": "node",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "incremental": true
  }
}
