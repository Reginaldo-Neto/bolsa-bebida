    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "bullmq": "^6.3.6",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.2.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.19.2",
    "vitest": "^5.0.1"
